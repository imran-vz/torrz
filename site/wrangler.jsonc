// The Torrz website: static files only, served by Cloudflare. No Worker code runs.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "torrz",
  "compatibility_date": "2026-11-01",
  // Cloudflare creates the DNS record and certificate for this on deploy (imran.codes is a
  // zone in the same account).
  "routes": [{ "pattern": "torrz.imran.codes", "custom_domain": true }],
  // One address: the workers.dev one and preview URLs stay off.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
